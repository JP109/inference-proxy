# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Upstream Provider Configuration
GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
GATEWAY_UPSTREAM_API_KEY=your_openai_or_provider_api_key_here
GATEWAY_DEFAULT_UPSTREAM_MODEL=gpt-4o-mini

# HTTP Connection Pool Limits
GATEWAY_HTTP_MAX_CONNECTIONS=100
GATEWAY_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_HTTP_KEEPALIVE_EXPIRY_SECONDS=30.0
GATEWAY_HTTP_CONNECT_TIMEOUT_SECONDS=5.0
GATEWAY_HTTP_READ_TIMEOUT_SECONDS=60.0

# Redis Cache & Limiter Configuration
GATEWAY_REDIS_URL=redis://localhost:6379/0

